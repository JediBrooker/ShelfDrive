<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Local MockWebServer and development instances may use HTTP. This file
       only replaces the production policy in debug builds. -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="user" />
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
