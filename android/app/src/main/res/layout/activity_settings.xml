<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar matches the Car Media browse header: big left-aligned title,
         optional back arrow on the left, orange divider underneath.
         No background — inherits the diagonal stripes from Polestar's launcher. -->
    <FrameLayout
        android:id="@+id/toolbarContainer"
        android:layout_width="match_parent"
        android:layout_height="96dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_32"
            android:scaleType="center"
            android:contentDescription="@string/settings_close" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="104dp"
            android:text="@string/settings_title"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium" />
    </FrameLayout>

    <!-- Orange accent divider, matches the line under the ShelfDrive header. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF7E2D" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Parked-only hint: this Activity is marked non-DO, so AAOS
                 will hide it while driving. Surface that in the UI too. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                android:background="#1F262B"
                android:textColor="#FF7E2D"
                android:textSize="24sp"
                android:text="@string/settings_parked_only" />

            <!-- Server section -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_server" />

            <LinearLayout style="@style/SettingsRow">
                <TextView style="@style/SettingsRowLabel" android:text="@string/settings_server_url" />
                <EditText
                    android:id="@+id/serverUrl"
                    style="@style/SettingsRowInput"
                    android:hint="@string/settings_server_url_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout style="@style/SettingsRow">
                <TextView style="@style/SettingsRowLabel" android:text="@string/settings_username" />
                <EditText
                    android:id="@+id/username"
                    style="@style/SettingsRowInput"
                    android:autofillHints="username"
                    android:inputType="text" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout style="@style/SettingsRow">
                <TextView style="@style/SettingsRowLabel" android:text="@string/settings_password" />
                <EditText
                    android:id="@+id/password"
                    style="@style/SettingsRowInput"
                    android:autofillHints="password"
                    android:inputType="textPassword" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <TextView
                android:id="@+id/serverStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="16dp"
                android:textColor="@color/settings_status_info"
                android:textSize="24sp"
                android:accessibilityLiveRegion="polite"
                android:text="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:gravity="end">

                <TextView
                    android:id="@+id/disconnectButton"
                    style="@style/SettingsButton.Outlined"
                    android:text="@string/settings_disconnect" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/signInButton"
                    style="@style/SettingsButton.Primary"
                    android:text="@string/car_sign_in_action" />
            </LinearLayout>

            <View style="@style/SettingsSectionDivider" />

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_privacy" />

            <TextView
                android:id="@+id/privacyPolicySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingBottom="16dp"
                android:text="@string/privacy_policy_summary"
                android:textColor="#B8C0C7"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/privacyPolicyButton"
                style="@style/SettingsButton.Outlined"
                android:layout_gravity="end"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/privacy_policy_view_online" />

            <View style="@style/SettingsSectionDivider" />

            <!-- Offline audiobook management is intentionally parked-only with
                 the rest of this Activity. Downloads themselves are started
                 from a book's AAOS custom browse action. -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_offline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingBottom="16dp"
                android:text="@string/settings_offline_help"
                android:textColor="#B8C0C7"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/offlineSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingBottom="16dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/settings_offline_summary_loading"
                android:textColor="@color/settings_status_info"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/offlineCurrentBookSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingBottom="16dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/settings_offline_current_book_none"
                android:textColor="#B8C0C7"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/downloadCurrentBookButton"
                style="@style/SettingsButton.Primary"
                android:layout_gravity="end"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="16dp"
                android:enabled="false"
                android:text="@string/settings_offline_download_current" />

            <LinearLayout style="@style/SettingsRow">
                <TextView
                    style="@style/SettingsRowLabel"
                    android:labelFor="@id/offlineMeteredSwitch"
                    android:text="@string/settings_offline_allow_metered" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/offlineMeteredSwitch"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:gravity="center" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:gravity="end">

                <TextView
                    android:id="@+id/cancelAllDownloadsButton"
                    style="@style/SettingsButton.Outlined"
                    android:enabled="false"
                    android:text="@string/settings_offline_cancel_all" />

                <Space
                    android:layout_width="16dp"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/deleteAllDownloadsButton"
                    style="@style/SettingsButton.Outlined"
                    android:enabled="false"
                    android:text="@string/settings_offline_delete_all" />
            </LinearLayout>

            <View style="@style/SettingsSectionDivider" />

            <!-- Playback section -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/settings_section_playback" />

            <LinearLayout style="@style/SettingsRow">
                <TextView style="@style/SettingsRowLabel" android:text="@string/settings_jump_forward" />
                <Spinner
                    android:id="@+id/jumpForwardSpinner"
                    style="@style/SettingsRowSpinner" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout style="@style/SettingsRow">
                <TextView style="@style/SettingsRowLabel" android:text="@string/settings_jump_backward" />
                <Spinner
                    android:id="@+id/jumpBackwardSpinner"
                    style="@style/SettingsRowSpinner" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout style="@style/SettingsRow">
                <TextView style="@style/SettingsRowLabel" android:text="@string/settings_disable_auto_rewind" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/disableAutoRewindSwitch"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:gravity="center" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="48dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
