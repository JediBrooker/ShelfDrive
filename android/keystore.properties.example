# Copy to keystore.properties (gitignored) and fill in real values.
# Used by app/build.gradle for the release signingConfig.
#
# Generate the keystore once with:
#   keytool -genkey -v \
#     -keystore shelfdrive-release.jks \
#     -keyalg RSA -keysize 2048 -validity 36500 \
#     -alias shelfdrive
#
# Then store it OUTSIDE the repo (e.g. ~/keys/shelfdrive-release.jks) and
# back it up — if you lose this key you can never push another update
# to the same listing on Google Play.

storeFile=/absolute/path/to/shelfdrive-release.jks
storePassword=changeme
keyAlias=shelfdrive
keyPassword=changeme
